{
  "name": "@stage-cut/render",
  "version": "1.0.0",
  "description": "Frame-precise StageCut video export and agent feedback CLI.",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "stagecut": "./src/cli.mjs"
  },
  "files": [
    "dist",
    "src/cli.mjs",
    "README.md",
    "LICENSE",
    "src/options.mjs"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugozhou-ai/stage-cut.git",
    "directory": "packages/render"
  },
  "scripts": {
    "build": "vite build && node scripts/build-types.mjs",
    "test": "node --test src/options.test.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.482",
    "@remotion/renderer": "4.0.482"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "vite": "^8.0.9"
  }
}
